---
import "../styles/global.css";
import { SITE } from "../lib/wire";
import Palette from "../components/Palette.astro";

interface Props {
  title?: string;
  description?: string;
  jsonHref?: string;
  markdownHref?: string;
  status?: string;
  frontmatter?: { title?: string; description?: string; markdownHref?: string };
}

const {
  title = SITE.name,
  description = SITE.tagline,
  jsonHref,
  markdownHref,
  status = "main ✓",
} = { ...Astro.props, ...Astro.props.frontmatter };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {jsonHref && <link rel="alternate" type="application/json" href={jsonHref} />}
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    {Astro.props.frontmatter
      ? <article class="markdown-document"><slot /></article>
      : <slot />}

    <Palette />

    <footer id="statusline" aria-hidden="true">
      <span class="seg on">{SITE.domain}</span>
      <span class="rule"></span>
      <span class="seg search-k" data-palette-open role="button" tabindex="0"
        >⌘K search</span
      >
      <span class="seg">{status}</span>
    </footer>

    <style>
      .markdown-document :global(h1) {
        font-size: 1.6em;
        color: var(--color-accent);
        margin-bottom: 1em;
      }
      .markdown-document :global(h2) {
        margin: 2em 0 1em;
        border-top: 1px solid var(--color-rule);
        padding-top: 1em;
        color: var(--color-accent);
      }
      .markdown-document :global(p),
      .markdown-document :global(pre),
      .markdown-document :global(ul),
      .markdown-document :global(ol) {
        margin: 1em 0;
      }
      .markdown-document :global(ul) { list-style: disc; padding-left: 1.6em; }
      .markdown-document :global(ol) { list-style: decimal; padding-left: 1.6em; }
      .markdown-document :global(li) { margin: .6em 0; }
      .markdown-document :global(pre) {
        padding: 1em;
        border: 1px solid var(--color-rule);
        overflow-wrap: anywhere;
      }
      .markdown-document { overflow-x: auto; }
      .markdown-document :global(table) { width: 100%; border-collapse: collapse; }
      .markdown-document :global(th),
      .markdown-document :global(td) {
        padding: .6em;
        border-bottom: 1px solid var(--color-rule);
        text-align: left;
        vertical-align: top;
      }
      #statusline .search-k {
        cursor: pointer;
      }
      #statusline .search-k:hover {
        color: var(--color-accent);
      }
    </style>

    <script is:inline>
      console.log(
        "%c ╦ ╦╦╦═╗╔═╗\n %c ║║║║╠╦╝║╣ \n %c ╚╩╝╩╩╚═╚═╝  the bytes on the wire",
        "color:#5cc9a7;font-family:monospace",
        "color:#5cc9a7;font-family:monospace",
        "color:#5cc9a7;font-family:monospace",
      );
    </script>
  </body>
</html>
